# petition-fleet secrets — copy to .env.petition-fleet (gitignored) and fill both values.
#
#   cp games/e2e/.env.petition-fleet.example games/e2e/.env.petition-fleet
#
# Do NOT commit the filled-in file.

# 12/24-word TEST mnemonic. The 3 bots derive their keys from it by addressIndex
# (A: 60-65, B: 70-75, C: 80-85). Gas-free mode means these keys never need a balance.
MNEMONIC=

# valve one.valve.city RPC key. The harness builds:
#   https://one.valve.city/rpc/<VALVE_RPC_KEY>/evm/943
VALVE_RPC_KEY=

# ── optional overrides (harness defaults shown) ──────────────────────────────
# CYCLE_SLEEP_SECS=60       # pause between a bot's cycles
# SIGNER_COUNT=5            # co-signers per petition
# SETTLE_INTERVAL_MS=60000
# PETITION_WINDOW_DAYS=30
