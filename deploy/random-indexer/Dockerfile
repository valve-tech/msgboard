# Production image for the gibsfinance/random ponder indexer (chain 943), vendored here and
# upgraded to ponder 0.16. The upstream Dockerfile was dev-oriented and broken; this is the
# corrected production build.
#
# Self-contained: the only special dependency, @gibs/random, is a public npm package that
# ships the contract ABIs + chain-943 addresses, so the build context is just this directory.
FROM node:24.22.1-slim
WORKDIR /app

# Config + source. ponder-env.d.ts is generated by codegen (TypeScript types only) and is
# not needed at runtime, so it is intentionally not copied.
COPY package.json package-lock.json tsconfig.json ponder.config.ts ponder.schema.ts ./
COPY src ./src
RUN npm ci

EXPOSE 42069

# The Postgres SCHEMA is supplied per-deploy as PONDER_SCHEMA (entropy_943_<n>) so each
# (re)index gets a fresh namespace and the previously-served schema is untouched until
# cutover. Bound to 0.0.0.0 so Caddy can reach it over the docker network.
CMD npx ponder start --hostname 0.0.0.0 --port 42069 --schema "${PONDER_SCHEMA:?PONDER_SCHEMA must be set (e.g. entropy_943_0)}"
